<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel do Professor</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 p-6">
  <div class="max-w-5xl mx-auto space-y-8">
    
    <header class="flex justify-between items-center border-b border-slate-800 pb-4">
      <h1 class="text-2xl font-bold text-blue-500">Painel do Professor</h1>
      <a href="index.html" class="text-sm text-slate-400 hover:text-white">Sair</a>
    </header>

    <!-- Formulário de Criar Prova -->
    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
      <h2 class="text-xl font-bold mb-4 text-slate-200">Cadastrar Nova Prova</h2>
      <form id="form-criar-prova" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-slate-400 mb-1">Título da Avaliação</label>
          <input type="text" id="titulo-prova" required placeholder="Ex: P1 - Citologia" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Turma / Disciplina</label>
          <input type="text" id="turma-disciplina" required placeholder="Ex: 3º Ano A - Biologia" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded text-white">
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs text-slate-400 mb-1">Link do Google Forms</label>
          <input type="url" id="link-forms" required placeholder="https://docs.google.com/forms/d/e/.../viewform" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Código Único (Ex: BIO-101)</label>
          <input type="text" id="codigo-unico" required placeholder="Ex: BIO-101" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded text-white uppercase">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Duração (Minutos)</label>
          <input type="number" id="duracao-minutos" value="50" required class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded text-white">
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Limite Tolerado de Saídas de Tela</label>
          <input type="number" id="limite-saidas" value="2" required class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded text-white">
        </div>
        <div class="md:col-span-2">
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 font-bold py-3 rounded text-white transition">SALVAR E GERAR PROVA</button>
        </div>
      </form>
    </div>

    <!-- Lista de Provas Criadas -->
    <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
      <h2 class="text-xl font-bold mb-4 text-slate-200">Provas Cadastradas</h2>
      <div id="lista-provas" class="space-y-4">
        <p class="text-slate-500">Carregando exames...</p>
      </div>
    </div>

  </div>

  <script type="module" src="./assets/js/professor.js"></script>
</body>
</html>
